---
import Page from '~/layouts/Page.astro';
import type { TemplateProps } from '~/templates/types';
import type { Content } from './content';
import meta from './meta';
import './theme.css';
import './style.css';

type Props = TemplateProps<Content>;
const { content: c, theme, seo, showcase } = Astro.props;

/** Reveal-delay class for the nth staggered element (none for 0). */
const delay = (n: number) => (n ? `d${n}` : '');

const range = (n: number) => Array.from({ length: n }, (_, i) => i);

/** Decorative corner flowers; the second is mirrored. */
const flowers = [
  { left: 'max(0px, calc(50% - 640px))', top: '52%', scale: 1, rot: -4, mirror: false },
  { left: 'min(calc(100% - 230px), calc(50% + 430px))', top: '48%', scale: 0.85, rot: 6, mirror: true },
];
---

<Page
  seo={{ ...c.seo, themeColor: meta.themeColor, favicon: meta.favicon, ...seo }}
  fontsHref={meta.fontsHref}
  theme={theme}
>
  <div id="vineRail" aria-hidden="true"></div>
  <canvas id="pollen" aria-hidden="true"></canvas>

  <nav id="nav">
    <a class="wordmark" href="#" set:html={c.wordmarkHtml} />
    <ul class="nav-links">
      {c.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <header>
    <div>
      <p class="est rv">{c.hero.est}</p>
      <h1 class="rv d1" set:html={c.hero.headingHtml} />
      <p class="hero-sub rv d2">{c.hero.sub}</p>
      <a href={c.hero.cta.href} class="btn rv d3">{c.hero.cta.label}</a>
    </div>
    <span class="hero-scroll">{c.hero.scrollLabel}</span>
    {
      flowers.map((f) => (
        <div
          class="hero-flower"
          style={`left:${f.left};top:${f.top};transform:scale(${f.mirror ? -f.scale : f.scale},${f.scale}) rotate(${f.rot}deg)`}
        >
          <svg width="220" height="260" viewBox="0 0 220 260" fill="none">
            <path d="M30 260 C 40 180, 80 120, 150 70" class="s-moss" stroke-width="2.6" fill="none" />
            <path d="M70 190 C 50 170, 46 140, 62 118 C 84 132, 88 164, 70 190 Z" class="f-leaf" />
            <path d="M108 130 C 130 120, 156 126, 168 148 C 146 160, 118 152, 108 130 Z" class="f-moss" />
            <g transform="translate(152,68)">
              {range(6).map((i) => <ellipse cx="0" cy="-16" rx="8" ry="17" class="f-terra" opacity=".9" transform={`rotate(${i * 60})`} />)}
              <circle r="7" class="f-gold" />
            </g>
            <g transform="translate(196,120) scale(.55)">
              {range(6).map((i) => <ellipse cx="0" cy="-16" rx="8" ry="17" class="f-terra-soft" opacity=".9" transform={`rotate(${i * 60})`} />)}
              <circle r="7" class="f-gold" />
            </g>
          </svg>
        </div>
      ))
    }
  </header>

  <section id="notes">
    <span class="kicker rv">{c.notes.kicker}</span>
    <h2 class="rv d1" set:html={c.notes.headingHtml} />
    <div class="notes">
      {
        c.notes.items.map((n, i) => (
          <div class={`note rv ${delay(i)}`}>
            <span class="stage">{n.stage}</span>
            <div class="glyph">
              {n.glyph === 'citrus' && (
                <svg width="84" height="84" viewBox="0 0 84 84" fill="none">
                  <circle cx="42" cy="46" r="26" class="s-moss" stroke-width="2.2" />
                  <circle cx="42" cy="46" r="19" class="s-terra" stroke-width="1.4" opacity=".8" />
                  {range(8).map((k) => (
                    <line
                      x1="42"
                      y1="46"
                      x2={42 + 17 * Math.cos((k * Math.PI) / 4)}
                      y2={46 + 17 * Math.sin((k * Math.PI) / 4)}
                      class="s-terra"
                      stroke-width="1.2"
                      opacity=".75"
                    />
                  ))}
                  <path d="M42 20 C 40 10, 48 6, 56 8 C 54 16, 48 20, 42 20 Z" class="f-leaf" />
                  <line x1="42" y1="20" x2="42" y2="13" class="s-moss" stroke-width="2" />
                </svg>
              )}
              {n.glyph === 'rose' && (
                <svg width="84" height="84" viewBox="0 0 84 84" fill="none">
                  <circle cx="42" cy="38" r="7" class="f-terra" />
                  <path
                    d="M42 31 C 35 28, 30 33, 32 40 C 27 41, 26 49, 33 51 C 31 58, 39 62, 44 57 C 51 61, 58 55, 54 48 C 60 44, 57 35, 50 36 C 51 29, 45 27, 42 31 Z"
                    class="s-terra"
                    stroke-width="2"
                    fill="none"
                  />
                  <path
                    d="M42 62 L 42 76 M42 70 C 35 68, 32 64, 31 60 M42 74 C 49 72, 52 68, 53 64"
                    class="s-moss"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    fill="none"
                  />
                </svg>
              )}
              {n.glyph === 'root' && (
                <svg width="84" height="84" viewBox="0 0 84 84" fill="none">
                  <path d="M30 24 C 34 14, 50 14, 54 24 L 50 30 L 34 30 Z" class="f-leaf" />
                  <line x1="20" y1="32" x2="64" y2="32" class="s-moss" stroke-width="2.4" stroke-linecap="round" />
                  <path
                    d="M42 32 L 42 52 M42 40 L 32 50 M42 40 L 52 50 M42 52 L 36 66 M42 52 L 49 68 M32 50 L 28 60 M52 50 L 57 60"
                    class="s-root"
                    stroke-width="2"
                    stroke-linecap="round"
                    fill="none"
                  />
                </svg>
              )}
            </div>
            <h3>{n.name}</h3>
            <div class="lat">{n.latin}</div>
            <p>{n.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="collection">
    <div class="col-inner">
      <span class="kicker rv">{c.collection.kicker}</span>
      <h2 class="rv d1" set:html={c.collection.headingHtml} />
      <div class="bottles">
        {
          c.collection.bottles.map((b, i) => (
            <div class={`bottle-card rv ${delay(i)}`}>
              <div class="bottle-stage">
                <svg class={`bottle bottle-${b.variant}`} width="150" height="270" viewBox="0 0 150 270">
                  <defs>
                    <linearGradient id={`glass-${b.variant}`} x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0%" class="glass-hi" stop-opacity=".55" />
                      <stop offset="18%" class="glass-hi" stop-opacity=".12" />
                      <stop offset="82%" class="glass-hi" stop-opacity=".08" />
                      <stop offset="100%" class="glass-shade" stop-opacity=".22" />
                    </linearGradient>
                    <linearGradient id={`liq-${b.variant}`} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" class="liq-stop" stop-opacity=".65" />
                      <stop offset="100%" class="liq-stop" />
                    </linearGradient>
                  </defs>
                  <rect x="58" y="12" width="34" height="34" rx="4" class="cap" />
                  <rect x="63" y="46" width="24" height="14" class="neck" />
                  <path
                    class="glass"
                    d="M40 62 L110 62 L118 96 L118 244 Q118 256 106 256 L44 256 Q32 256 32 244 L32 96 Z"
                  />
                  <path
                    d="M36 130 L114 130 L114 244 Q114 252 106 252 L44 252 Q36 252 36 244 Z"
                    fill={`url(#liq-${b.variant})`}
                  />
                  <path
                    d="M40 62 L110 62 L118 96 L118 244 Q118 256 106 256 L44 256 Q32 256 32 244 L32 96 Z"
                    fill={`url(#glass-${b.variant})`}
                  />
                  <rect x="46" y="150" width="58" height="74" rx="2" class="label" />
                  <text x="75" y="172" text-anchor="middle" class="label-brand" font-size="9.5" letter-spacing="1">
                    {c.labelBrand}
                  </text>
                  <line x1="54" y1="180" x2="96" y2="180" class="label-rule" />
                  {b.label.split(' ').map((w, k) => (
                    <text x="75" y={196 + k * 12} text-anchor="middle" class="label-name" font-size="7.5" letter-spacing="2.5">
                      {w}
                    </text>
                  ))}
                  <line x1="44" y1="70" x2="44" y2="240" class="shine" />
                </svg>
              </div>
              <h3>{b.name}</h3>
              <div class="notes-line">{b.notes}</div>
              <div class="price">{b.price}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="story">
    <div class="story-inner">
      <span class="kicker rv">{c.story.kicker}</span>
      <blockquote class="rv d1" set:html={c.story.quoteHtml} />
      <cite class="rv d2">{c.story.cite}</cite>
    </div>
  </section>

  <section id="almanac">
    <span class="kicker rv">{c.almanac.kicker}</span>
    <h2 class="rv d1" set:html={c.almanac.headingHtml} />
    <div class="alm-rows rv d2">
      {
        c.almanac.rows.map((r) => (
          <div class="alm-row">
            <span class="mon">{r.month}</span>
            <span class="what">{r.title}</span>
            <p>{r.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <footer>
    <div class="foot-grid">
      <div>
        <a class="wordmark" href="#" set:html={c.wordmarkHtml} />
        <p class="address" set:html={c.footer.addressHtml} />
      </div>
      <p>
        <Fragment set:html={c.footer.creditHtml} />
        {
          showcase && c.showcase && (
            <>
              <br />
              <Fragment set:html={c.showcase.footerHtml} />
            </>
          )
        }
      </p>
    </div>
  </footer>

  {showcase && c.showcase && <a class="hub-chip" href={c.showcase.chipHref}>{c.showcase.chipLabel}</a>}
</Page>

<script>
  import { reveal, scrolledClass } from '~/lib/motion';
  import { initPollen } from './pollen';
  import { initVine } from './vine';

  const rail = document.getElementById('vineRail');
  if (rail) initVine(rail);
  const pollen = document.getElementById('pollen');
  if (pollen instanceof HTMLCanvasElement) initPollen(pollen);

  const nav = document.getElementById('nav');
  if (nav) scrolledClass(nav);
  reveal('.rv', { threshold: 0.15 });
</script>
