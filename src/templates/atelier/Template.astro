---
import Page from '~/layouts/Page.astro';
import type { TemplateProps } from '~/templates/types';
import type { Content } from './content';
import { drawingSvg } from './drawings';
import meta from './meta';
import './theme.css';
import './style.css';

type Props = TemplateProps<Content>;
const { content: c, theme, seo, showcase = false } = Astro.props;

const delay = (i: number) => (i > 0 ? ` d${Math.min(i, 2)}` : '');
---

<Page
  seo={{ ...c.seo, themeColor: meta.themeColor, favicon: meta.favicon, ...seo }}
  fontsHref={meta.fontsHref}
  theme={theme}
>
  <nav id="nav">
    <a class="wordmark" href="#" set:html={c.wordmarkHtml} />
    <ul class="nav-links">
      {c.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <header>
    <div>
      <h1 class="rv" set:html={c.hero.headingHtml} />
      <p class="hero-sub rv d1">{c.hero.sub}</p>
      <div class="hero-meta rv d2">
        {
          c.hero.stats.map((s) => (
            <div>
              <b>{s.value}</b>
              {s.label}
            </div>
          ))
        }
      </div>
    </div>
    <figure class="hero-draw rv d1">
      <svg viewBox="0 0 560 420" fill="none" class="drawable" set:html={drawingSvg(c.hero.drawing)} />
      <figcaption class="draw-cap"><span>{c.hero.figure}</span><span>{c.hero.scale}</span></figcaption>
    </figure>
  </header>

  <div class="sec-head" id={c.work.id}>
    <h2 class="rv" set:html={c.work.headingHtml} />
    <span class="hint rv d1">{c.work.hint}</span>
  </div>
  <div class="gallery" id="gallery">
    {
      c.work.projects.map((p) => (
        <div class="proj">
          <div class="frame">
            <svg viewBox="0 0 560 380" fill="none" class="drawable" set:html={drawingSvg(p.drawing)} />
          </div>
          <div class="info">
            <span class="no">{p.no}</span>
            <h3>{p.name}</h3>
            <span class="yr">{p.meta}</span>
          </div>
          <p class="desc">{p.description}</p>
        </div>
      ))
    }
  </div>

  <section id={c.philosophy.id}>
    <div class="phil-inner">
      <blockquote class="rv" set:html={c.philosophy.quoteHtml} />
      <cite class="rv d1">{c.philosophy.cite}</cite>
    </div>
  </section>

  <section class="practice" id={c.practice.id}>
    {
      c.practice.columns.map((col, i) => (
        <div class={`pr-col rv${delay(i)}`}>
          <span class="k">{col.label}</span>
          <p set:html={col.bodyHtml} />
        </div>
      ))
    }
  </section>

  <footer>
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="wordmark" href="#" set:html={c.wordmarkHtml} />
        <p>{c.footer.note}</p>
      </div>
      <p>
        <Fragment set:html={c.footer.creditHtml} />
        {
          showcase && (
            <>
              <br />
              Part of <a href="/">Weft</a> — 25 sites, 25 styles.
            </>
          )
        }
      </p>
    </div>
  </footer>

  {showcase && <a class="hub-chip" href="/">← Weft</a>}
</Page>

<script>
  import { reveal, scrolledClass } from '~/lib/motion';
  import { initDrawings, initWheelScroll } from './effects';

  initDrawings(document.querySelectorAll<SVGElement>('.drawable'));

  const gallery = document.getElementById('gallery');
  if (gallery) initWheelScroll(gallery);

  const nav = document.getElementById('nav');
  if (nav) scrolledClass(nav);
  reveal('.rv', { threshold: 0.15 });
</script>
