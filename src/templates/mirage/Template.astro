---
import Page from '~/layouts/Page.astro';
import type { TemplateProps } from '~/templates/types';
import type { Content } from './content';
import meta from './meta';
import './theme.css';
import './style.css';

type Props = TemplateProps<Content>;
const { content: c, theme, seo, showcase } = Astro.props;

const delays = ['', 'd1', 'd2'];
---

<Page
  seo={{ ...c.seo, themeColor: meta.themeColor, favicon: meta.favicon, ...seo }}
  fontsHref={meta.fontsHref}
  theme={theme}
>
  <nav id="nav">
    <a class="logo" href="#">{c.logo}</a>
    <ul class="nav-links">
      {c.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <header>
    <div class="stars" id="stars" aria-hidden="true"></div>
    <div class="sun" aria-hidden="true"></div>
    <div class="haze" aria-hidden="true"></div>
    <div class="floor" aria-hidden="true"></div>
    <svg class="statue" width="150" height="240" viewBox="0 0 150 240" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="marble" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" class="marble-hi"></stop>
          <stop offset="55%" class="marble-mid"></stop>
          <stop offset="100%" class="marble-lo"></stop>
        </linearGradient>
      </defs>
      <ellipse cx="75" cy="52" rx="20" ry="24" fill="url(#marble)"></ellipse>
      <path class="hair" d="M60 62 Q52 44 62 32 Q58 52 66 58 Z"></path>
      <path d="M55 74 Q75 66 95 74 L102 128 Q75 140 48 128 Z" fill="url(#marble)"></path>
      <path d="M48 128 L42 170 L58 170 L60 132 Z" fill="url(#marble)"></path>
      <path d="M102 128 L108 170 L92 170 L90 132 Z" fill="url(#marble)"></path>
      <rect x="30" y="170" width="90" height="16" fill="url(#marble)"></rect>
      <rect x="38" y="186" width="74" height="40" fill="url(#marble)"></rect>
      <line class="flute" x1="46" y1="190" x2="46" y2="222"></line>
      <line class="flute" x1="62" y1="190" x2="62" y2="222"></line>
      <line class="flute" x1="78" y1="190" x2="78" y2="222"></line>
      <line class="flute" x1="94" y1="190" x2="94" y2="222"></line>
      <rect x="30" y="226" width="90" height="12" fill="url(#marble)"></rect>
    </svg>
    <svg class="palm p1" width="180" height="260" viewBox="0 0 180 260" fill="none" aria-hidden="true">
      <path class="trunk" d="M84 260 C88 200 92 150 86 110"></path>
      <g class="fronds">
        <path d="M86 112 C60 96 30 96 12 112 C40 78 72 84 86 104 Z"></path>
        <path d="M86 112 C112 96 144 96 166 114 C136 80 100 84 86 104 Z"></path>
        <path d="M86 108 C70 84 66 56 78 36 C60 66 68 96 84 108 Z"></path>
        <path d="M88 108 C104 84 110 58 100 36 C120 64 110 96 90 108 Z"></path>
        <path d="M86 110 C86 88 92 66 106 54 C88 60 78 90 84 110 Z"></path>
      </g>
    </svg>
    <div class="hero-content">
      <div class="hero-inner">
        <h1>{c.hero.title}</h1>
        <div class="jp-sub">{c.hero.subtitle}</div>
        <p class="hero-tag" set:html={c.hero.tagHtml} />
      </div>
    </div>
  </header>

  <section id={c.drops.id}>
    <span class="kicker rv">{c.drops.kicker}</span>
    <h2 class="rv d1" set:html={c.drops.headingHtml} />
    <div class="drops">
      {
        c.drops.items.map((d, i) => (
          <div class:list={['drop', 'rv', delays[i % 3]]}>
            <div class="art" data-art={d.art} data-label={d.artLabel} />
            <div class="info">
              <h3>{d.title}</h3>
              <div class="fmt">{d.format}</div>
              <div class="pr">{d.price}</div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id={c.manifesto.id}>
    <div class="mani-inner">
      <span class="kicker rv">{c.manifesto.kicker}</span>
      <blockquote class="rv d1" set:html={c.manifesto.quoteHtml} />
      <cite class="rv d2">{c.manifesto.cite}</cite>
    </div>
  </section>

  <section id={c.transmissions.id}>
    <span class="kicker rv">{c.transmissions.kicker}</span>
    <h2 class="rv d1" set:html={c.transmissions.headingHtml} />
    <div class="trans rv d2">
      {
        c.transmissions.items.map((t) => (
          <div class="tr">
            <span class="dt" set:html={t.whenHtml} />
            <div>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </div>
            <span class="loc">{t.place}</span>
          </div>
        ))
      }
    </div>
  </section>

  <footer>
    <div class="foot-grid">
      <div>
        <a class="logo sm" href="#">{c.logo}</a>
        <p class="foot-note" set:html={c.footer.noteHtml} />
      </div>
      <p>
        <Fragment set:html={c.footer.creditHtml} />
        {
          showcase && (
            <>
              <br />
              Part of <a href="/">Weft</a> — 25 sites, 25 styles.
            </>
          )
        }
      </p>
    </div>
  </footer>

  {showcase && <a class="hub-chip" href="/">← Weft</a>}
</Page>

<script>
  import { reveal, scrolledClass } from '~/lib/motion';
  import { dropArt } from './drops';
  import { stars } from './stars';

  const starField = document.getElementById('stars');
  if (starField) stars(starField);
  dropArt(document.querySelectorAll<HTMLElement>('[data-art]'));

  const nav = document.getElementById('nav');
  if (nav) scrolledClass(nav);
  reveal('.rv', { threshold: 0.15 });
</script>
