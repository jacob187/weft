---
import Page from '~/layouts/Page.astro';
import type { TemplateProps } from '~/templates/types';
import { pastrySvg } from './art';
import type { Content } from './content';
import meta from './meta';
import './theme.css';
import './style.css';

type Props = TemplateProps<Content>;
const { content: c, theme, seo, showcase = false } = Astro.props;

const delay = (i: number) => (i > 0 ? ` d${Math.min(i, 3)}` : '');
// The track slides by half its width; six copies keep it wider than any screen.
const MARQUEE_COPIES = 6;
---

<Page
  seo={{ ...c.seo, themeColor: meta.themeColor, favicon: meta.favicon, ...seo }}
  fontsHref={meta.fontsHref}
  theme={theme}
>
  <canvas id="goo" aria-hidden="true"></canvas>

  <nav id="nav">
    <a class="logo" href="#"><span class="box">{c.brand.mark}</span>{c.brand.name}</a>
    <ul class="nav-links">
      {c.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a class="order-btn" href={c.orderCta.href}>{c.orderCta.label}</a></li>
    </ul>
  </nav>

  <main>
    <header>
      <div>
        <div class="badge rv"><i></i>{c.hero.badge}</div>
        <h1 class="rv d1" set:html={c.hero.headingHtml} />
        <p class="hero-sub rv d2">{c.hero.sub}</p>
        <a class="squish rv d3" href={c.hero.cta.href}>{c.hero.cta.label}</a>
        <p class="hero-note rv d3">{c.hero.note}</p>
      </div>
    </header>

    <div class="pastramarquee" aria-hidden="true">
      <div class="pm-track">
        {
          Array.from({ length: MARQUEE_COPIES }, () => (
            <span>
              {c.marquee.items.map((item, i) => (
                <Fragment>{i > 0 && ' '}{item}{' '}<i>{c.marquee.separator}</i></Fragment>
              ))}
            </span>
          ))
        }
      </div>
    </div>

    <section id={c.menu.id}>
      <span class="kicker rv">{c.menu.kicker}</span>
      <h2 class="rv d1">{c.menu.heading}</h2>
      <div class="goods">
        {
          c.menu.items.map((item, i) => (
            <div class={`good rv${delay(i)}`}>
              <span class="price">{item.price}</span>
              <div class="art" set:html={pastrySvg(item.art)} />
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <span class={`tag tone-${item.tagTone}`}>{item.tag}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section id={c.hourly.id}>
      <div class="hr-inner">
        <span class="kicker rv">{c.hourly.kicker}</span>
        <h2 class="rv d1">{c.hourly.heading}</h2>
        <div class="oven-row rv d2" style={`--now-label:${JSON.stringify(c.hourly.nowLabel)}`}>
          {
            c.hourly.schedule.map((s) => (
              <div class="slot" data-hour={parseInt(s.time, 10)}>
                <div class="t">{s.time}</div>
                <div class="w">{s.what}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id={c.promise.id}>
      <blockquote class="rv" set:html={c.promise.quoteHtml} />
      <cite class="rv d1">{c.promise.cite}</cite>
    </section>
  </main>

  <footer>
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="#"><span class="box">{c.brand.mark}</span>{c.brand.name}</a>
        <p set:html={c.footer.noteHtml} />
      </div>
      <p>
        <Fragment set:html={c.footer.creditHtml} />
        {
          showcase && (
            <>
              <br />
              Part of the <a href="/">Fable Showcase</a> — 25 sites, 25 styles.
            </>
          )
        }
      </p>
    </div>
  </footer>

  {showcase && <a class="hub-chip" href="/">← Fable Showcase</a>}
</Page>

<script>
  import { reveal, scrolledClass } from '~/lib/motion';
  import { initGoo } from './goo';
  import { markNowSlot } from './oven';

  const goo = document.getElementById('goo');
  if (goo instanceof HTMLCanvasElement) initGoo(goo);

  markNowSlot([...document.querySelectorAll<HTMLElement>('.slot')]);

  const nav = document.getElementById('nav');
  if (nav) scrolledClass(nav);
  reveal('.rv', { threshold: 0.15 });
</script>
